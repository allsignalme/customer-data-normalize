{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["es2020"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "strict": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "types": [],
    "skipLibCheck": true
  },
  "include": ["src"]
}
